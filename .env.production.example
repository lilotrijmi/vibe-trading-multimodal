# Vibe-Trading Multimodal — Production environment for Dokploy
# Copy this to Dokploy Environment tab.
# ==== CRITICAL: API KEY (auto-generated) ====
VIBE_TRADING_API_KEY=99e28f753bd1798b9c825cf8d4af8c39ab5d264f04a6b45fdb1aa3de6321f015

# ==== LLM Provider (PICK ONE BLOCK, REPLACE PLACEHOLDERS) ====

# Max output tokens for the chat LLM. Increase if responses are truncated.
LANGCHAIN_MAX_TOKENS=8192

# OpenRouter (recommended)
LANGCHAIN_PROVIDER=openrouter
LANGCHAIN_MODEL_NAME=deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=sk-or-v1-REPLACE-WITH-YOUR-KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
# LANGCHAIN_PROVIDER=openai
# LANGCHAIN_MODEL_NAME=gpt-5.5-instant
# OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-KEY
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# LANGCHAIN_PROVIDER=anthropic
# LANGCHAIN_MODEL_NAME=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-KEY
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ==== Multimodal Vision (optional) ====
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o
# VISION_FALLBACK_PROVIDERS=anthropic,ollama

# Ollama (if running locally on VPS)
# VISION_PROVIDER=ollama
# VISION_MODEL=llama3.2-vision
# OLLAMA_BASE_URL=http://ollama:11434

# ==== Storage Paths ====
MULTIMODAL_STORAGE_DIR=/app/agent/data/multimodal
VIBE_TRADING_DB_PATH=/app/agent/data/vibe_trading.db

# ==== Misc ====
VIBE_TRADING_TRUST_DOCKER_LOOPBACK=1
PYTHONUNBUFFERED=1
